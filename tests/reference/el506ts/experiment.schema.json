{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EL-506TS simulator experiment v1",
  "description": "Reference evidence only. Does not execute the simulator or assert application parity.",
  "definitions": {
    "key": {
      "type": "string",
      "enum": [
        "EL506-K01",
        "EL506-K02",
        "EL506-K03",
        "EL506-K04",
        "EL506-K05",
        "EL506-K06",
        "EL506-K07",
        "EL506-K08",
        "EL506-K09",
        "EL506-K10",
        "EL506-K11",
        "EL506-K12",
        "EL506-K13",
        "EL506-K14",
        "EL506-K15",
        "EL506-K16",
        "EL506-K17",
        "EL506-K18",
        "EL506-K19",
        "EL506-K20",
        "EL506-K21",
        "EL506-K22",
        "EL506-K23",
        "EL506-K24",
        "EL506-K25",
        "EL506-K26",
        "EL506-K27",
        "EL506-K28",
        "EL506-K29",
        "EL506-K30",
        "EL506-K31",
        "EL506-K32",
        "EL506-K33",
        "EL506-K34",
        "EL506-K35",
        "EL506-K36",
        "EL506-K37",
        "EL506-K38",
        "EL506-K39",
        "EL506-K40",
        "EL506-K41",
        "EL506-K42",
        "EL506-K43",
        "EL506-K44",
        "EL506-K45",
        "EL506-K46",
        "EL506-K47",
        "EL506-K48"
      ]
    },
    "sequence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/key"
      }
    },
    "textObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "observed"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "not-applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "exactValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "value",
        "basis"
      ],
      "properties": {
        "encoding": {
          "enum": [
            "decimal-string",
            "rational-string",
            "structured-json-string"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "displayed",
            "recall-probe",
            "manual",
            "physical-device"
          ]
        }
      }
    },
    "valueObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "observed"
            },
            "value": {
              "$ref": "#/definitions/exactValue"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "not-applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upper_line",
        "lower_line",
        "indicators",
        "scroll_arrows",
        "cursor",
        "insert_mode",
        "prompt",
        "selected_result_component"
      ],
      "properties": {
        "upper_line": {
          "type": "string"
        },
        "lower_line": {
          "type": "string"
        },
        "indicators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "scroll_arrows": {
          "type": "array",
          "items": {
            "enum": [
              "left",
              "right",
              "up",
              "down"
            ]
          },
          "uniqueItems": true
        },
        "cursor": {
          "$ref": "#/definitions/textObservation"
        },
        "insert_mode": {
          "$ref": "#/definitions/textObservation"
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_result_component": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after_step",
        "display",
        "result"
      ],
      "properties": {
        "after_step": {
          "type": "integer",
          "minimum": 0
        },
        "display": {
          "$ref": "#/definitions/display"
        },
        "result": {
          "$ref": "#/definitions/valueObservation"
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "before",
        "after",
        "evidence_steps"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "$ref": "#/definitions/valueObservation"
        },
        "after": {
          "$ref": "#/definitions/valueObservation"
        },
        "evidence_steps": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at_step",
        "message",
        "position",
        "recovery_steps",
        "recovered_at_step"
      ],
      "properties": {
        "at_step": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/definitions/textObservation"
        },
        "recovery_steps": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "recovered_at_step": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "kind",
        "reference",
        "page",
        "scope"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "simulator",
            "operation-guide",
            "full-manual",
            "physical-device",
            "prior-transcript"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "description",
        "resolution"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "disagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ids",
        "description",
        "selected_source_id",
        "reason"
      ],
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "selected_source_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "roadmap_item",
    "catalog_id",
    "simulator",
    "capture",
    "initial_state",
    "sequence",
    "frames",
    "stored_values",
    "errors",
    "sources",
    "oracle",
    "ambiguities",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^el506-[0-9]{3}-[a-z0-9-]+$"
    },
    "roadmap_item": {
      "type": "string",
      "pattern": "^EL506-[0-9]{3}$"
    },
    "catalog_id": {
      "const": "el506-physical-keys-v1"
    },
    "simulator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "product",
        "build",
        "runtime_sha256",
        "locale",
        "operating_system"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "runtime_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "operating_system": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "timezone",
        "method",
        "evidence_kind",
        "source_ids"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "evidence_kind": {
          "enum": [
            "live-simulator",
            "manual",
            "physical-device",
            "prior-live-transcript"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "initial_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reset",
        "setup_sequence",
        "mode",
        "settings",
        "display",
        "stores"
      ],
      "properties": {
        "reset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "description"
          ],
          "properties": {
            "kind": {
              "enum": [
                "simulator-chrome-reset",
                "physical-reset",
                "documented-state"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "setup_sequence": {
          "$ref": "#/definitions/sequence"
        },
        "mode": {
          "$ref": "#/definitions/textObservation"
        },
        "settings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "observation"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "observation": {
                "$ref": "#/definitions/textObservation"
              }
            }
          }
        },
        "display": {
          "$ref": "#/definitions/display"
        },
        "stores": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/store"
          }
        }
      }
    },
    "sequence": {
      "$ref": "#/definitions/sequence",
      "minItems": 1,
      "type": "array"
    },
    "frames": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/frame"
      },
      "minItems": 2
    },
    "stored_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "observations"
      ],
      "properties": {
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/store"
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/error"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/source"
      },
      "minItems": 1
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_source_id",
        "simulator_exception_ids",
        "disagreements"
      ],
      "properties": {
        "selected_source_id": {
          "type": "string",
          "minLength": 1
        },
        "simulator_exception_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "disagreements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/disagreement"
          }
        }
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ambiguity"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
